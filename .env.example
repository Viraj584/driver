# No server secrets belong in the Flutter client. These placeholders are for
# future local emulator tooling only; configure through your own environment.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
GOOGLE_SERVER_CLIENT_ID=your-google-web-oauth-client-id.apps.googleusercontent.com
TRUST_JUGGLER_USE_FIREBASE_EMULATORS=true
FIREBASE_EMULATOR_HOST=127.0.0.1
# Set this only to force a local-only build without Firebase initialization.
TRUST_JUGGLER_FIREBASE_DISABLED=false
